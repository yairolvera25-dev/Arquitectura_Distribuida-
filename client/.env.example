# Servicios web de cada VM (red ZeroTier del equipo), sin diagonal al final
EXPO_PUBLIC_SERVIDOR_WINDOWS_URL=http://10.191.84.109:3000
EXPO_PUBLIC_SERVIDOR_LINUX_URL=http://10.191.84.219:3000
# Misma clave que API_KEY en el .env de ambos servidores
EXPO_PUBLIC_API_KEY=cambia-esta-clave

# Quién guarda los registros (columnas Usuario, Nombre, Paterno y Materno)
EXPO_PUBLIC_USUARIO=
EXPO_PUBLIC_NOMBRE=
EXPO_PUBLIC_PATERNO=
EXPO_PUBLIC_MATERNO=
