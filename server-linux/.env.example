# Puerto y dirección donde escucha el servicio web
PORT=3000
HOST=0.0.0.0

# Misma clave que EXPO_PUBLIC_API_KEY en client/.env (mínimo 16 caracteres).
# Genérala con: openssl rand -hex 24
API_KEY=cambia-esta-clave

# Firma los tokens de inicio de sesión. Debe ser la MISMA en los dos servidores y NUNCA
# va en la app ni en el repo (mínimo 32 caracteres). Genérala una sola vez con:
#   openssl rand -hex 32
TOKEN_SECRET=

# Clave privada RSA (PEM, 2048 bits o más) que descifra los registros del clima. De ella se saca la
# pública, que es la que cifra. El archivo NUNCA va en el repo ni en capturas, y solo lo puede leer
# el servicio. Si se pierde, los registros cifrados no se pueden volver a leer.
# deploy/instalar.sh la genera si no existe; también se puede generar con
#   python practicas-python/generar_claves_rsa.py
# Ruta relativa a la carpeta del servicio (/opt/clima-api).
RSA_CLAVE_PRIVADA=claves/privada.pem

# PostgreSQL en la misma VM (solo localhost). Usuario con permisos mínimos: ver sql/02_usuario_api.sql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=UPP
DB_USER=upp_api
#
# ¡OJO con la contraseña! Va SIEMPRE entre comillas dobles.
# Sin comillas, dotenv corta el valor en el primer "#" y el resto se pierde:
#   DB_PASSWORD=Abc#1234    ->  la API intenta entrar con "Abc"
#   DB_PASSWORD="Abc#1234"  ->  correcto
# El fallo se ve como 'password authentication failed' aunque el archivo parezca bien.
DB_PASSWORD=""

# Orígenes permitidos para la versión web de la app, separados por coma.
# Vacío = cualquiera (la API key sigue siendo obligatoria).
CORS_ORIGINS=
