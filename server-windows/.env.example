# Puerto y dirección donde escucha el servicio web
PORT=3000
HOST=0.0.0.0

# Misma clave que EXPO_PUBLIC_API_KEY en client/.env (mínimo 16 caracteres).
API_KEY=cambia-esta-clave

# SQL Server Express en la misma VM. Usuario con permisos mínimos: ver sql/02_usuario_api.sql
DB_SERVER=localhost
# Puerto TCP fijo de la instancia (el mismo que se abrió en el firewall en la Actividad 2).
DB_PORT=1433
# Alternativa: deja DB_PORT vacío y pon el nombre de la instancia (requiere el servicio SQL Server Browser).
DB_INSTANCE=
DB_NAME=UPP
DB_USER=upp_api
DB_PASSWORD=

# Orígenes permitidos para la versión web de la app, separados por coma.
# Vacío = cualquiera (la API key sigue siendo obligatoria).
CORS_ORIGINS=
